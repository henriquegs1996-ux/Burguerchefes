<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Burguer Chefes | Cardápio e Contato</title>

  <meta name="description"
        content="Burguer Chefes — confira nosso cardápio, Instagram, localização e entre em contato pelo WhatsApp.">

  <meta name="theme-color" content="#0b0b0b">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at top, #4a0000 0%, #160000 35%, #050505 75%);
      color: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      overflow-x: hidden;
    }

    .card {
      width: 100%;
      max-width: 430px;
      min-height: 720px;
      background: rgba(12, 12, 12, 0.96);
      border: 1px solid rgba(255, 193, 7, 0.28);
      border-radius: 30px;
      padding: 30px 22px;
      text-align: center;
      box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.7),
        0 0 45px rgba(255, 50, 0, 0.15);
      position: relative;
      overflow: hidden;
    }

    .card::before {
      content: "";
      position: absolute;
      width: 280px;
      height: 280px;
      background: #e50914;
      filter: blur(110px);
      opacity: 0.15;
      top: -140px;
      left: 50%;
      transform: translateX(-50%);
    }

    .logo {
      width: 125px;
      height: 125px;
      margin: 5px auto 20px;
      border-radius: 50%;
      background: linear-gradient(145deg, #e50914, #8d0000);
      border: 4px solid #ffc107;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 58px;
      box-shadow:
        0 0 25px rgba(229, 9, 20, 0.45),
        inset 0 0 20px rgba(0, 0, 0, 0.4);
      animation: float 3s ease-in-out infinite;
      position: relative;
      z-index: 2;
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-7px);
      }
    }

    h1 {
      font-size: 32px;
      font-weight: 900;
      letter-spacing: -1px;
      margin-bottom: 7px;
      position: relative;
      z-index: 2;
    }

    .highlight {
      color: #ffc107;
    }

    .username {
      color: #aaa;
      font-size: 15px;
      margin-bottom: 12px;
      position: relative;
      z-index: 2;
    }

    .description {
      color: #ddd;
      line-height: 1.5;
      font-size: 15px;
      max-width: 340px;
      margin: 0 auto 25px;
      position: relative;
      z-index: 2;
    }

    .buttons {
      display: flex;
      flex-direction: column;
      gap: 13px;
      position: relative;
      z-index: 2;
    }

    .button {
      text-decoration: none;
      color: #fff;
      min-height: 59px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      padding: 0 20px;
      gap: 15px;
      font-weight: 800;
      font-size: 16px;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        filter 0.2s ease;
      border: 1px solid rgba(255,255,255,0.1);
      box-shadow: 0 8px 20px rgba(0,0,0,0.25);
    }

    .button:hover {
      transform: translateY(-3px) scale(1.01);
      filter: brightness(1.08);
    }

    .button:active {
      transform: scale(0.97);
    }

    .icon {
      width: 34px;
      height: 34px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 22px;
      flex-shrink: 0;
    }

    .button span:last-child {
      flex: 1;
      text-align: center;
      margin-right: 34px;
    }

    .instagram {
      background: linear-gradient(
        135deg,
        #833ab4,
        #fd1d1d,
        #fcb045
      );
    }

    .whatsapp {
      background: linear-gradient(
        135deg,
        #075e54,
        #25d366
      );
    }

    .menu {
      background: linear-gradient(
        135deg,
        #e50914,
        #a90000
      );
    }

    .location {
      background: linear-gradient(
        135deg,
        #252525,
        #111
      );
    }

    .share {
      background: linear-gradient(
        135deg,
        #333,
        #171717
      );
    }

    .footer {
      margin-top: 28px;
      color: #777;
      font-size: 12px;
      line-height: 1.5;
      position: relative;
      z-index: 2;
    }

    .footer strong {
      color: #ffc107;
    }

    .pulse {
      display: inline-block;
      width: 8px;
      height: 8px;
      background: #25d366;
      border-radius: 50%;
      margin-right: 5px;
      box-shadow: 0 0 10px #25d366;
    }

    @media (max-width: 380px) {
      .card {
        padding: 25px 17px;
        border-radius: 25px;
      }

      h1 {
        font-size: 28px;
      }

      .logo {
        width: 110px;
        height: 110px;
        font-size: 50px;
      }
    }
  </style>
</head>

<body>

  <main class="card">

    <div class="logo">
      🍔
    </div>

    <h1>
      Burguer <span class="highlight">Chefes</span>
    </h1>

    <div class="username">
      @burguerchefes_
    </div>

    <p class="description">
      🍔 Sabor de verdade, do jeito que você gosta!
      <br>
      Confira nosso cardápio e peça pelo WhatsApp.
    </p>

    <div class="buttons">

      <!-- INSTAGRAM -->
      <a
        class="button instagram"
        href="https://www.instagram.com/burguerchefes_/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="icon">📸</div>
        <span>Instagram</span>
      </a>

      <!-- WHATSAPP -->
      <a
        class="button whatsapp"
        href="https://wa.me/5511939089345?text=Ol%C3%A1%20Burguer%20Chefes!%20Vim%20pelo%20cart%C3%A3o%20digital."
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="icon">📲</div>
        <span>Peça pelo WhatsApp</span>
      </a>

      <!-- CARDÁPIO -->
      <a
        class="button menu"
        href="https://wa.me/p/26088886507381806/5511939089345"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="icon">🍔</div>
        <span>Ver Cardápio</span>
      </a>

      <!-- LOCALIZAÇÃO -->
      <a
        class="button location"
        href="https://www.google.com/maps/search/?api=1&query=Estrada+Velha+da+Olaria%2C+124%2C+Jardim+Arco-Iris%2C+Cotia%2C+SP%2C+06719-150"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="icon">📍</div>
        <span>Como Chegar</span>
      </a>

      <!-- COMPARTILHAR -->
      <a
        class="button share"
        href="#"
        onclick="compartilhar(event)"
      >
        <div class="icon">🔗</div>
        <span>Compartilhar</span>
      </a>

    </div>

    <div class="footer">
      <span class="pulse"></span>
      Peça agora pelo WhatsApp
      <br>
      <strong>Burguer Chefes</strong>
      <br>
      © 2026 Burguer Chefes
    </div>

  </main>

  <script>

    async function compartilhar(event) {

      event.preventDefault();

      const dados = {
        title: "Burguer Chefes",
        text: "🍔 Conheça o Burguer Chefes!",
        url: window.location.href
      };

      if (navigator.share) {

        try {

          await navigator.share(dados);

        } catch (erro) {

          console.log("Compartilhamento cancelado.");

        }

      } else {

        try {

          await navigator.clipboard.writeText(
            window.location.href
          );

          alert(
            "✅ Link copiado!\n\n" +
            "Agora você pode enviar o cartão para seus amigos."
          );

        } catch (erro) {

          alert(
            "Copie o endereço desta página para compartilhar o cartão."
          );

        }

      }

    }

  </script>

</body>
</html>
```
